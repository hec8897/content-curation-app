# 이 파일을 .env로 복사해서 쓴다. .env는 gitignore되어 있다.
#   cp .env.example .env
#
# 서버는 uv가 이 파일을 읽어 넘겨준다 — 플래그 없이는 로드되지 않는다.
#   uv run --env-file .env uvicorn app.main:app --reload --port 8000

# Google 로그인용 audience. Google Cloud Console의 **웹 애플리케이션** 클라이언트 ID여야 하고,
# Flutter의 googleServerClientId(lib/data/api.dart)와 반드시 같아야 한다.
# iOS/Android 클라이언트 ID가 아니다 — 여기가 가장 많이 틀리는 지점이다.
# 비워두면 Google 로그인 라우트만 503을 돌려주고 나머지 기능은 정상 동작한다.
GOOGLE_CLIENT_ID=

# 우리 액세스 토큰 서명 키. 로컬에서는 비워도 개발용 기본값으로 동작하지만,
# 배포 환경에서는 반드시 임의의 긴 문자열을 넣는다. 바꾸면 기존 토큰이 전부 무효가 된다.
JWT_SECRET=

# 비워두면 docker-compose.yml의 로컬 Postgres를 가리키는 기본값을 쓴다.
# 다른 DB에 붙일 때만 채운다.
DATABASE_URL=
